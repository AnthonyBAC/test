# Copiar a qa/.env.local; no versionar ese archivo.
QA_API_URL=http://localhost:4450
QA_FRONTEND_URL=http://localhost:3350
QA_CDP_URL=http://localhost:9227
QA_POSTGRES_CONTAINER=atlas-postgres
QA_POSTGRES_DB=atlas
QA_POSTGRES_USER=postgres
QA_ADMIN_USER=admin
QA_ADMIN_PASSWORD=REEMPLAZAR_CON_CREDENCIAL_LOCAL
# Las pruebas dinámicas crean registros QA y ejecutan carga sobre el entorno local.
QA_ALLOW_MUTATIONS=false
# Opcional: QA_RUN_ID para continuar una ejecución concreta.
# JMETER_HOME=C:/herramientas/apache-jmeter-5.6.3
# JAVA_HOME=C:/herramientas/jdk-21
# SONAR_HOST_URL=http://host.docker.internal:9000
# SONAR_PROJECT_KEY=atlas-ep3-20261019
# SONAR_TOKEN=REEMPLAZAR_SOLO_EN_EL_ARCHIVO_LOCAL
