# ============================================================
# Atlas - Variables de entorno
# Copia este archivo a `.env.local` y completa los valores reales.
# `.env.local` NO debe versionarse (está en .gitignore).
# ============================================================

# --- Entorno ---
# Entorno de ejecución: development | production | test
NODE_ENV=production

# --- Base de datos (PostgreSQL) ---
# Usuario y contraseña de la base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu-contrasena-postgres
# Nombre de la base de datos
POSTGRES_DB=atlas
# URL de conexión usada por el backend (desarrollo local)
DATABASE_URL=postgres://postgres:tu-contrasena-postgres@localhost:5432/atlas

# --- Puertos ---
# Puerto interno del backend
PORT=4000
# Puerto expuesto para conectarse a PostgreSQL
PORT_POSTGRES=15432
# Puerto expuesto para acceder a la API
PORT_BACKEND=4450
# Puerto expuesto para acceder al frontend
PORT_FRONTEND=3350

# --- Docker Compose ---
# Nombre del proyecto de docker-compose
COMPOSE_PROJECT_NAME=atlas

# --- Seguridad (JWT) ---
# Llave para cifrar y firmar los tokens de sesión.
# IMPORTANTE: usar un valor aleatorio largo y no compartirlo.
JWT_SECRET=tu-secreto-jwt-cambiar

# --- Frontend ---
# URL de la API consumida por el frontend
VITE_API_URL=http://localhost:4000
